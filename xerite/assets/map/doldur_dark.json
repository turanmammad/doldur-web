{
  "version": 8,
  "name": "Doldur Dark",
  "metadata": {
    "doldur:note": "Xəritə fonu #0E1B1F (tokens: mapBg). Yol və su rəngləri qəsdən sönükdür — markerlər (current #12E28C) ekranın yeganə parlaq elementidir. README: «current ekranın ≤10%-i».",
    "doldur:key-placeholder": "{MAPTILER_KEY} runtime-da Env.mapTilerKey ilə əvəzlənir (MapStyleLoader)."
  },
  "glyphs": "https://api.maptiler.com/fonts/{fontstack}/{range}.pbf?key={MAPTILER_KEY}",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://api.maptiler.com/tiles/v3/tiles.json?key={MAPTILER_KEY}"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#0E1B1F" }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "fill-color": "rgba(18,226,140,0.05)" }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "paint": { "fill-color": "rgba(233,239,237,0.03)" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#0A1417" }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "rgba(233,239,237,0.05)",
        "fill-outline-color": "rgba(233,239,237,0.03)"
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track"],
      "minzoom": 13,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "rgba(233,239,237,0.04)",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 1, 18, 6]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "rgba(233,239,237,0.05)",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 18, 9]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary", "trunk"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "rgba(233,239,237,0.07)",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.8, 18, 12]
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "rgba(233,239,237,0.10)",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1, 18, 16]
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["<=", "admin_level", 2],
      "paint": {
        "line-color": "rgba(233,239,237,0.14)",
        "line-width": 0.8,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "city", "town"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 11, 12, 15],
        "text-transform": "none",
        "text-letter-spacing": 0.02
      },
      "paint": {
        "text-color": "#8CA0A4",
        "text-halo-color": "#0B1518",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-suburb",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "suburb", "neighbourhood"],
      "minzoom": 12,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-letter-spacing": 0.04
      },
      "paint": {
        "text-color": "#6B7B80",
        "text-halo-color": "#0B1518",
        "text-halo-width": 1
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 10,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#5B6A6E",
        "text-halo-color": "#0E1B1F",
        "text-halo-width": 1
      }
    }
  ]
}
